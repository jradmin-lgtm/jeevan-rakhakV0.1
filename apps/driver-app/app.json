{
  "expo": {
    "name": "Jeevan Rakshak Driver",
    "slug": "jr-driver-app",
    "version": "2.1.9",
    "orientation": "portrait",
    "scheme": "jrdriver",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "web"
    ],
    "jsEngine": "hermes",
    "newArchEnabled": false,
    "web": {
      "bundler": "metro"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0F172A",
      "resizeMode": "contain"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "jradmin29",
    "android": {
      "package": "com.jeevanrakshak.driver",
      "versionCode": 52,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Jeevan Rakshak needs photo access to upload KYC documents (RC, PUC, fitness, insurance, licence).",
          "cameraPermission": "Jeevan Rakshak needs camera access to photograph KYC documents (RC, PUC, fitness, insurance, licence)."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6b1dd022-52b7-4c70-b0e8-93cf5bdf7e32"
      },
      "googleWebClientId": "269522337472-seov7qni7vlbviin0cm4tpgc9l87upi9.apps.googleusercontent.com"
    }
  }
}
